generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model appointments {
  id               Int       @id @default(autoincrement())
  name             String?   @db.VarChar(255)
  address          String?
  aadhar_no        String?   @db.VarChar(12)
  father_name      String?   @db.VarChar(255)
  mobile_no        String?   @db.VarChar(15)
  disease          String?   @db.VarChar(255)
  doctor_name      String?   @db.VarChar(255)
  age              Int?
  appointment_date DateTime? @db.Date
  time_slot        String?   @db.VarChar(50)
  gender           String?   @db.VarChar(10)
  appointment_type String?   @db.VarChar(50)
  created_at       DateTime? @default(now()) @db.Timestamp(6)
  updated_at       DateTime? @db.Timestamp(6)
}

model attendance {
  id         Int       @id @default(autoincrement())
  doctor_id  Int
  created_at DateTime? @default(now()) @db.Timestamp(6)
  doctors    doctors   @relation(fields: [doctor_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_doctor")
}

model doctors {
  id            Int             @id @default(autoincrement())
  user_id       Int
  job_title     String          @db.VarChar(255)
  position      String          @db.VarChar(255)
  status        String          @db.VarChar(50)
  created_at    DateTime?       @default(now()) @db.Timestamp(6)
  updated_at    DateTime?       @db.Timestamp(6)
  attendance    attendance[]
  users         users           @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_user")
  experience    experience[]
  feedback      feedback[]
  qualification qualification[]
}

model experience {
  id                Int       @id @default(autoincrement())
  doctor_id         Int
  job_title         String?   @db.VarChar(255)
  start_date        DateTime? @db.Date
  end_date          DateTime? @db.Date
  hospital          String?   @db.VarChar(255)
  offer_letter      String?
  experience_letter String?
  other             String?
  created_at        DateTime? @default(now()) @db.Timestamp(6)
  updated_at        DateTime? @db.Timestamp(6)
  doctors           doctors   @relation(fields: [doctor_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_doctor")
}

model feedback {
  id          Int       @id @default(autoincrement())
  user_id     Int
  doctor_id   Int
  medicine_id Int?
  feedback    String?
  created_at  DateTime? @default(now()) @db.Timestamp(6)
  updated_at  DateTime? @db.Timestamp(6)
  doctors     doctors   @relation(fields: [doctor_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_doctor")
  medicine    medicine? @relation(fields: [medicine_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_medicine")
  users       users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_user")
}

model medicine {
  id           Int            @id @default(autoincrement())
  name         String?        @db.VarChar(255)
  expiry       DateTime?      @db.Date
  manufactured DateTime?      @db.Date
  image        String?
  disease      Json?
  description  String?
  price        Decimal?       @db.Decimal(10, 2)
  discount     Decimal?       @db.Decimal(5, 2)
  created_at   DateTime?      @default(now()) @db.Timestamp(6)
  updated_at   DateTime?      @db.Timestamp(6)
  feedback     feedback[]
  storehistory storehistory[]
}

model qualification {
  id           Int       @id @default(autoincrement())
  doctor_id    Int
  degree       String?   @db.VarChar(255)
  college      String?   @db.VarChar(255)
  passing_year Int?
  percentage   Decimal?  @db.Decimal(5, 2)
  documents    Json?
  created_at   DateTime? @default(now()) @db.Timestamp(6)
  updated_at   DateTime? @db.Timestamp(6)
  doctors      doctors   @relation(fields: [doctor_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_doctor")
}

model storehistory {
  id          Int       @id @default(autoincrement())
  medicine_id Int
  user_id     Int
  created_at  DateTime? @default(now()) @db.Timestamp(6)
  updated_at  DateTime? @db.Timestamp(6)
  medicine    medicine  @relation(fields: [medicine_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_medicine")
  users       users     @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_user")
}

model users {
  id           Int            @id @default(autoincrement())
  name         String         @db.VarChar(255)
  phone_number String         @unique @db.VarChar(15)
  address      String
  gender       String         @db.VarChar(10)
  email        String?        @db.VarChar(255)
  password     String         @db.VarChar(255)
  dob          DateTime       @db.Date
  role         String         @default("user") @db.VarChar(50)
  image        String?
  created_at   DateTime?      @default(now()) @db.Timestamp(6)
  updated_at   DateTime?      @db.Timestamp(6)
  doctors      doctors[]
  feedback     feedback[]
  storehistory storehistory[]
}
